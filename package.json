{
  "name": "emberfold-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@11.19.1",
  "engines": { "node": "^24.22.1 || ^26.13.0" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @hivemagnus/emberfold -w @hivemagnus/emberfold-server -w @hivemagnus/emberfold-cli",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "lint": "eslint packages test",
    "contracts:write": "node scripts/contracts.mjs --write",
    "contracts:check": "node scripts/contracts.mjs",
    "privacy:check": "node scripts/privacy.mjs",
    "pack:check": "node scripts/package-check.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run contracts:check && npm run privacy:check && npm run pack:check && npm run evaluate",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "dotenv": "18.0.9"
  }
}
