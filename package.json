{
  "name": "emberfold-workspace",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@11.19.1",
  "engines": { "node": "^24.22.3 || ^26.13.1" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @hivemagnus/emberfold -w @hivemagnus/emberfold-server -w @hivemagnus/emberfold-cli",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "hermes:build": "tsc -p integrations/emberfold-hermes/tsconfig.json",
    "hermes:test": "npm run hermes:build && python3 -m unittest discover -s integrations/emberfold-hermes/tests -v",
    "hermes:pack": "node scripts/hermes-package-check.mjs",
    "lint": "eslint packages test integrations/emberfold-hermes/src",
    "contracts:write": "node scripts/contracts.mjs --write",
    "contracts:check": "node scripts/contracts.mjs",
    "privacy:check": "node scripts/privacy.mjs",
    "pack:check": "node scripts/package-check.mjs",
    "compat:ardent": "npm run build -w @hivemagnus/emberfold && node scripts/ardent-compatibility.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run hermes:test && npm run hermes:pack && npm run contracts:check && npm run privacy:check && npm run pack:check && npm run evaluate",
    "deploy": "node scripts/deploy.mjs",
    "release": "node scripts/release.mjs"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "dotenv": "18.0.9"
  }
}
