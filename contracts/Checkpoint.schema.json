{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_message_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "object",
      "properties": {
        "items": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "enum": [
                  "decision",
                  "observation",
                  "open_item",
                  "correction",
                  "status",
                  "canon",
                  "hypothesis",
                  "behavior_change"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "source_message_ids": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "historical_status": {
                "type": "string",
                "const": "historical_unverified"
              },
              "epistemic_status": {
                "type": "string",
                "enum": [
                  "reported",
                  "observation",
                  "hypothesis",
                  "decision",
                  "unresolved"
                ]
              },
              "supersedes": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resolves": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "text",
              "source_message_ids",
              "historical_status",
              "epistemic_status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "message_id",
          "source_sha256",
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "general",
        "creative",
        "reflective"
      ]
    },
    "generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "namespace",
    "parent_id",
    "source_message_ids",
    "source_sha256",
    "summary",
    "protected",
    "policy_sha256",
    "profile",
    "generation",
    "provider",
    "model",
    "created_at",
    "checkpoint_sha256"
  ],
  "additionalProperties": false
}
