{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "default": "general",
      "type": "string",
      "enum": [
        "general",
        "creative",
        "reflective"
      ]
    },
    "revision": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "recent_exchanges": {
      "default": 2,
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "trigger_ratio": {
      "default": 0.7,
      "type": "number",
      "minimum": 0.1,
      "maximum": 1
    },
    "summary_max_tokens": {
      "default": 4000,
      "type": "integer",
      "minimum": 128,
      "maximum": 9007199254740991
    },
    "summarizer_input_tokens": {
      "default": 16000,
      "type": "integer",
      "minimum": 512,
      "maximum": 9007199254740991
    },
    "summarizer_output_tokens": {
      "default": 4000,
      "type": "integer",
      "minimum": 128,
      "maximum": 9007199254740991
    },
    "max_passes": {
      "default": 32,
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "require_measured_tokens": {
      "default": false,
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
